{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "illness_script.schema.json",
  "title": "TUS illness script (one per condition)",
  "type": "object",
  "required": [
    "id", "version", "status", "sources", "ad", "taksonomi",
    "tipik_hasta", "patofizyoloji", "anahtar_bulgular",
    "ilk_tetkik", "kesin_tani", "ilk_tedavi"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/definitions/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "$ref": "#/definitions/status" },
    "author": { "type": "string", "minLength": 1 },
    "reviewed_by": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ad": { "type": "string", "minLength": 1 },
    "taksonomi": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": { "$ref": "#/definitions/identifier" }
      }
    },
    "tipik_hasta": { "type": "string", "minLength": 1 },
    "patofizyoloji": { "type": "string", "minLength": 1 },
    "anahtar_bulgular": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "patognomonik": { "type": ["string", "null"] },
    "ilk_tetkik": { "type": "string", "minLength": 1 },
    "kesin_tani": { "type": "string", "minLength": 1 },
    "ilk_tedavi": { "type": "string", "minLength": 1 },
    "klasik_komplikasyon": { "type": ["string", "null"] },
    "ayirici": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hastalik", "ayirt_edici"],
        "additionalProperties": false,
        "properties": {
          "hastalik": { "$ref": "#/definitions/identifier" },
          "ayirt_edici": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tus_gecmisi": {
      "type": "array",
      "items": { "type": "string" }
    },
    "kart_uret": {
      "type": "object",
      "required": ["bilgi", "vaka", "celdirici", "ayirici"],
      "additionalProperties": false,
      "properties": {
        "bilgi": { "type": "boolean" },
        "vaka": { "type": "boolean" },
        "celdirici": { "type": "boolean" },
        "ayirici": { "type": "boolean" },
        "spot": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "status": { "enum": ["draft", "reviewed", "published", "deprecated"] },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
  }
}
