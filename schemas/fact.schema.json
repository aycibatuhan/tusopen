{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fact.schema.json",
  "title": "TUS standalone fact (use sparingly; prefer illness scripts)",
  "type": "object",
  "required": ["id", "version", "status", "sources", "ad", "taksonomi", "metin"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/definitions/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "$ref": "#/definitions/status" },
    "author": { "type": "string", "minLength": 1 },
    "reviewed_by": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ad": { "type": "string", "minLength": 1 },
    "taksonomi": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": { "$ref": "#/definitions/identifier" }
      }
    },
    "metin": { "type": "string", "minLength": 1 },
    "tus_gecmisi": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gorsel": {
      "type": "object",
      "required": ["dosya", "kaynak", "lisans", "yazar"],
      "additionalProperties": false,
      "properties": {
        "dosya": { "type": "string", "minLength": 1 },
        "kaynak": { "type": "string", "minLength": 1 },
        "lisans": { "type": "string", "minLength": 1 },
        "yazar": { "type": "string", "minLength": 1 },
        "etiketler": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ad", "x", "y", "w", "h"],
            "additionalProperties": false,
            "properties": {
              "ad": { "type": "string", "minLength": 1 },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number" },
              "h": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "status": { "enum": ["draft", "reviewed", "published", "deprecated"] },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
  }
}
