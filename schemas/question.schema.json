{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "question.schema.json",
  "title": "TUS question reference (metadata only, no question text)",
  "type": "object",
  "required": ["version", "status", "kapsam", "sources", "sinav", "sorular"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "status": { "$ref": "#/definitions/status" },
    "kapsam": { "enum": ["full", "sample10"] },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sinav": {
      "type": "object",
      "required": ["yil", "donem", "test"],
      "additionalProperties": false,
      "properties": {
        "yil": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "donem": { "enum": ["ilkbahar", "sonbahar"] },
        "test": { "enum": ["TTBT", "KTBT"] }
      }
    },
    "sorular": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/soru" }
    }
  },
  "definitions": {
    "status": { "enum": ["draft", "reviewed", "published", "deprecated"] },
    "soru": {
      "type": "object",
      "required": [
        "no", "id", "cevap", "iptal", "ders", "konu", "alt_konu",
        "hastalik", "benzer", "notlar"
      ],
      "additionalProperties": false,
      "properties": {
        "no": { "type": "integer", "minimum": 1, "maximum": 200 },
        "id": {
          "type": "string",
          "pattern": "^tus-[0-9]{4}-(ilkbahar|sonbahar)-(ttbt|ktbt)-[0-9]{1,3}$"
        },
        "cevap": {
          "anyOf": [
            { "enum": ["A", "B", "C", "D", "E"] },
            { "type": "null" }
          ]
        },
        "iptal": { "type": "boolean" },
        "ders": { "$ref": "#/definitions/optional_identifier" },
        "konu": { "$ref": "#/definitions/optional_identifier" },
        "alt_konu": { "$ref": "#/definitions/optional_identifier" },
        "hastalik": {
          "type": "array",
          "items": { "$ref": "#/definitions/identifier" }
        },
        "soru_tipi": {
          "anyOf": [
            { "enum": ["vaka", "bilgi"] },
            { "type": "null" }
          ]
        },
        "alt_tip": {
          "anyOf": [
            { "enum": ["tani", "tetkik", "tedavi", "komplikasyon", "mekanizma"] },
            { "type": "null" }
          ]
        },
        "zorluk": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 5 },
            { "type": "null" }
          ]
        },
        "benzer": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notlar": { "type": "string" }
      }
    },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "optional_identifier": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        { "type": "null" }
      ]
    }
  }
}
