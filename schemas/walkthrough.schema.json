{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "walkthrough.schema.json",
  "title": "TUS walkthrough (own-words reasoning on a real past question)",
  "type": "object",
  "required": [
    "id", "version", "status", "sources", "soru_ref", "sinanan_bilgi", "mantik"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^wt-tus-[0-9]{4}-(ilkbahar|sonbahar)-(ttbt|ktbt)-[0-9]{1,3}$"
    },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "$ref": "#/definitions/status" },
    "author": { "type": "string", "minLength": 1 },
    "reviewed_by": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "soru_ref": {
      "type": "string",
      "pattern": "^tus-[0-9]{4}-(ilkbahar|sonbahar)-(ttbt|ktbt)-[0-9]{1,3}$"
    },
    "sinanan_bilgi": { "type": "string", "minLength": 1 },
    "ipucu_turleri": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "gurultu_turleri": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "mantik": { "type": "string", "minLength": 1 },
    "celdirici_kavramlar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kavram", "neden_yanlis", "dogru_oldugu_durum"],
        "additionalProperties": false,
        "properties": {
          "kavram": { "type": "string", "minLength": 1 },
          "neden_yanlis": { "type": "string", "minLength": 1 },
          "dogru_oldugu_durum": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "status": { "enum": ["draft", "reviewed", "published", "deprecated"] }
  }
}
